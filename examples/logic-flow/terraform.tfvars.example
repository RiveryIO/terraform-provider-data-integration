# Copy to terraform.tfvars and fill in. Prefer the DATA_INTEGRATION_* env vars
# for the provider credentials (api_url / api_token / account_id / environment_id).

api_url        = "http://localhost:8008"
account_id     = "<account_id>"
environment_id = "<existing_environment_id>"
group_id       = "<env_group_cross_id>" # required for the Snowflake step to route
# api_token    = "<token>"              # better: export DATA_INTEGRATION_API_TOKEN

river_name   = "TF_logic_multistep"
sub_river_id = "<cross_id of an existing river to run as step 1>"

# Python (logicode) step — OPTIONAL. Leave python_file_id empty to omit it; the
# API cannot upload code via Terraform, so this must reference an existing file.
python_file_id = ""
# python_file_id = "<uploaded_code_file_id>"
# python_size    = "XS"
# python_packages = ["pandas"]

# Snowflake SQL / DB transformation step
sf_account_name    = "<account>.<region>"
sf_username        = "<user>"
sf_password        = "<password>"
sf_warehouse       = "COMPUTE_WH"
sf_role            = "SYSADMIN"
sf_target_database = "<database>"
sf_target_schema   = "PUBLIC"
sf_target_table    = "TF_LOGIC_TRANSFORM"
sql_query          = "SELECT 1 AS id, 'hello' AS msg"
