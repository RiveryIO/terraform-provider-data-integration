# Copy to terraform.tfvars and fill in.

environment_id = "<existing_environment_id>"
group_id       = "<env_group_cross_id>" # required for the Snowflake step to route

data_flow_name   = "TF_logic_multistep"
sub_data_flow_id = "<cross_id of an existing data flow to run as step 1>"

# Python (logicode) step — included by default (include_python_step = true).
# include_python_step = false
# python_size          = "XS"
# python_packages      = ["pandas"]

# Snowflake SQL / DB transformation step
sf_account_name    = "<account>.<region>"
sf_username        = "<user>"
sf_password        = "<password>"
sf_warehouse       = "COMPUTE_WH"
sf_role            = "SYSADMIN"
sf_target_database = "<database>"
sf_target_schema   = "PUBLIC"
sf_target_table    = "TF_LOGIC_TRANSFORM"
sql_query          = "SELECT 1 AS id, 'hello' AS msg"
